      "name": "Incoming Call (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -736,
        160
      ],
      "webhookId": "d967176f-75b5-405a-8391-a08cbc9f2919",
      "notes": "Telephony layer (e.g. a Twilio Studio Flow or a custom STT service) POSTs here after transcribing the caller's utterance. Expected body: {call_id, session_id, transcript, client_email, client_name}."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:8000/turn",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"session_id\": \"{{$json.body.session_id}}\",\n  \"message\": \"{{$json.body.message}}\"\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "557549c4-cc68-4137-9dce-b61e3f112942",
      "name": "Intent Detection + Property Match (AI Agent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -496,
        160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Calls the FastAPI /turn endpoint (the LangGraph agent from the notebook). It returns {session_id, reply, intent}, and — when intent == 'book' and every required field (name/email/date/time/timezone) has been confirmed in conversation — an additional `appointment_request` object the rest of this workflow consumes. See docs/API_DOCUMENTATION.md."
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.appointment_request ? $json.intent : '__not_ready__' }}",
                    "rightValue": "book",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "7fb346cd-0c91-4a88-9bf3-6e7483b32a56"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{$json.intent}}",
                    "rightValue": "reschedule",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "cfc62131-57f9-4e9b-85fa-3f40a25f2e49"
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent + ($json.appointment_request ? '-ready' : '-pending') }}",
                    "rightValue": "cancel",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "id": "135c4d9e-0898-4315-bfa8-bf8fb9e264d5"
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "40615751-1317-4741-8d62-f914d9f434fb",
      "name": "Route By Intent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        -256,
        160
      ],
      "notes": "Branches into: book / reschedule / cancel / other (faq, recommend, objection, smalltalk, unsafe, end_call all fall through to 'other', which just returns the reply with no calendar/email/CRM side-effects)."
    },
    {
      "parameters": {
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "primary"
        },
        "start": "={{$json.appointment_request.start_iso}}",
        "end": "={{$json.appointment_request.end_iso}}",
        "additionalFields": {
